+// An upgrade-prompt id (cuid) carried in ?prompt= / the subscribe form. Anything
+// else is ignored — the helpers are shop-scoped, so a foreign id is a no-op too.
+const PROMPT_ID_RE = /^[a-z0-9]{20,40}$/i;
+
+/**
+ * Item 5: arrival from an upgrade prompt. Stamps arrivedAtPlansAt (first time,
+ * shop-scoped) and returns what the cards need to highlight the fit plan —
+ * { planName, promptId, n, covers }. "Covers your N products" is only true
+ * when the count was complete (not truncated) AND the fit plan's monthly
+ * limit is at least N (D12). Tracking can never affect the page: every read
+ * is guarded and a failure just means no highlight.
+ */
+async function readPromptArrival(shop, url) {
+  const promptId = url.searchParams.get("prompt") || "";
+  if (!PROMPT_ID_RE.test(promptId)) return null;
+  const fitName = url.searchParams.get("fit") || "";
+  const fitDef = Object.values(BILLING_PLANS).find((p) => p.planName === fitName) ?? null;
+  const highlight = { planName: fitDef?.planName ?? null, promptId, n: null, covers: false };
+  try {
+    await markPromptArrived(shop, promptId);
+    if (fitDef && prisma.upgradePrompt?.findFirst) {
+      const row = await prisma.upgradePrompt.findFirst({ where: { id: promptId, shop }, select: { n: true, truncated: true } });
+      if (row && Number.isFinite(row.n)) {
+        highlight.n = row.n;
+        highlight.covers = !row.truncated && fitDef.monthlyLimit >= row.n;
+      }
+    }
+  } catch {
+    // tracking only — the Plans page renders regardless
+  }
+  return highlight;
+}
