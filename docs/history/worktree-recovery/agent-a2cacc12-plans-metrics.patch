+/**
+ * Products with NO Navaal description row — the Products-page "without AI
+ * content" number (brief item 5, D15).
+ *
+ * Counts DISTINCT products that have a description row in ANY status (draft /
+ * approved / published / rejected — Navaal already touched them) and subtracts
+ * that from the live Shopify product count. This is exactly the set the
+ * Optimise action skips (existingIds), so the number a merchant sees before a
+ * run equals what the run will target. The previous
+ * `total − published − draft` over-subtracted a product that had BOTH a
+ * published and a draft row (it was counted twice) and mis-counted products
+ * whose only row was a meta title.
+ *
+ * @param {string} shop
+ * @param {number} productsCount live productsCount from the Admin API
+ * @returns {Promise<number>} never negative
+ */
+export async function countProductsWithoutAiContent(shop, productsCount) {
+  const [r] = await prisma.$queryRaw`
+    SELECT COUNT(DISTINCT "productId")::integer AS covered
+    FROM "GeneratedContent"
+    WHERE shop = ${shop}
+      AND "contentType" = 'description'
+      AND "productId" LIKE 'gid://shopify/Product/%'
+  `;
+  return Math.max(0, (Number(productsCount) || 0) - Number(r?.covered ?? 0));
+}
